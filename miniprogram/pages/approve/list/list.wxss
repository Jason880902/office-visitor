/* pages/approve/list/list.wxss */
.filter-bar {
	display: flex;
	background: #fff;
	padding: 16rpx 20rpx;
	margin-bottom: 20rpx;
	border-radius: 12rpx;
}

.filter-item {
	flex: 1;
	text-align: center;
	padding: 12rpx 0;
	font-size: 26rpx;
	color: #666;
	border-radius: 8rpx;
}

.filter-item.active {
	background: #1890FF;
	color: #fff;
}

.approve-card {
	margin-bottom: 20rpx;
}

.card-header {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 16rpx;
	padding-bottom: 16rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.visitor-info {
	flex: 1;
}

.visitor-name {
	display: block;
	font-size: 30rpx;
	font-weight: 500;
	color: #333;
}

.visitor-company {
	display: block;
	font-size: 24rpx;
	color: #999;
	margin-top: 4rpx;
}

.card-body {
	padding: 0;
}

.info-row {
	display: flex;
	margin-bottom: 12rpx;
	font-size: 28rpx;
}

.info-row .label {
	color: #999;
	width: 160rpx;
}

.info-row .value {
	color: #333;
	flex: 1;
}

.card-footer {
	display: flex;
	justify-content: flex-end;
	margin-top: 20rpx;
	padding-top: 16rpx;
	border-top: 1rpx solid #f0f0f0;
	gap: 16rpx;
}

.btn-small {
	padding: 8rpx 24rpx;
	font-size: 24rpx;
	border-radius: 6rpx;
	line-height: 1.5;
	min-width: 120rpx;
}

.load-more {
	text-align: center;
	padding: 30rpx;
	color: #999;
	font-size: 26rpx;
}
