<!--pages/admin/index/index.wxml - 管理后台首页-->
<view class="container">
	<!-- 数据概览 -->
	<view class="card">
		<view class="section-title">数据概览</view>
		<view class="data-grid">
			<view class="data-item">
				<text class="data-num">{{dashboard.todayCount || 0}}</text>
				<text class="data-label">今日预约</text>
			</view>
			<view class="data-item">
				<text class="data-num">{{dashboard.pendingCount || 0}}</text>
				<text class="data-label">待审批</text>
			</view>
			<view class="data-item">
				<text class="data-num">{{dashboard.visitedCount || 0}}</text>
				<text class="data-label">今日来访</text>
			</view>
			<view class="data-item">
				<text class="data-num">{{dashboard.totalCount || 0}}</text>
				<text class="data-label">总预约数</text>
			</view>
		</view>
	</view>

	<!-- 功能菜单 -->
	<view class="card">
		<view class="section-title">功能菜单</view>
		<view class="menu-grid">
			<view class="menu-item" bindtap="goVisitors">
				<image src="/images/admin/visitors.png" mode="aspectFit" />
				<text>访客管理</text>
			</view>
			<view class="menu-item" bindtap="goDevices">
				<image src="/images/admin/devices.png" mode="aspectFit" />
				<text>门禁设备</text>
			</view>
			<view class="menu-item" bindtap="goExport">
				<image src="/images/admin/export.png" mode="aspectFit" />
				<text>数据导出</text>
			</view>
			<view class="menu-item" bindtap="goSettings">
				<image src="/images/admin/settings.png" mode="aspectFit" />
				<text>系统设置</text>
			</view>
		</view>
	</view>

	<!-- 快捷操作 -->
	<view class="card">
		<view class="section-title">快捷操作</view>
		<view class="action-list">
			<view class="action-item" bindtap="goPendingList">
				<text class="action-text">待审批列表</text>
				<view class="action-right">
					<text class="action-badge" wx:if="{{dashboard.pendingCount > 0}}">{{dashboard.pendingCount}}</text>
					<text class="action-arrow">›</text>
				</view>
			</view>
			<view class="action-item" bindtap="goTodayList">
				<text class="action-text">今日来访记录</text>
				<text class="action-arrow">›</text>
			</view>
			<view class="action-item" bindtap="goScan">
				<text class="action-text">扫码核验</text>
				<text class="action-arrow">›</text>
			</view>
		</view>
	</view>
</view>
