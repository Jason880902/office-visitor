/* pages/admin/visitors/visitors.wxss */
.search-bar {
	display: flex;
	background: #fff;
	padding: 16rpx 20rpx;
	margin-bottom: 16rpx;
	border-radius: 12rpx;
	gap: 16rpx;
}

.search-input {
	flex: 1;
	padding: 12rpx 16rpx;
	background: #f5f5f5;
	border-radius: 8rpx;
	font-size: 26rpx;
}

.btn-search {
	padding: 8rpx 24rpx;
	font-size: 26rpx;
	line-height: 1.5;
}

.filter-bar {
	display: flex;
	background: #fff;
	padding: 12rpx 20rpx;
	margin-bottom: 20rpx;
	border-radius: 12rpx;
}

.filter-item {
	flex: 1;
	text-align: center;
	padding: 10rpx 0;
	font-size: 24rpx;
	color: #666;
	border-radius: 8rpx;
}

.filter-item.active {
	background: #1890FF;
	color: #fff;
}

.visitor-card {
	margin-bottom: 16rpx;
}

.card-header {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 12rpx;
	padding-bottom: 12rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.visitor-info {
	flex: 1;
}

.visitor-name {
	display: block;
	font-size: 30rpx;
	font-weight: 500;
	color: #333;
}

.visitor-phone {
	display: block;
	font-size: 24rpx;
	color: #999;
	margin-top: 4rpx;
}

.info-row {
	display: flex;
	margin-bottom: 8rpx;
	font-size: 26rpx;
}

.info-row .label {
	color: #999;
	width: 140rpx;
}

.info-row .value {
	color: #333;
	flex: 1;
}

.load-more {
	text-align: center;
	padding: 30rpx;
	color: #999;
	font-size: 26rpx;
}
