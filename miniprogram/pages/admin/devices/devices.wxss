/* pages/admin/devices/devices.wxss */
.section-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 24rpx;
}

.section-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #333;
}

.btn-small {
	padding: 8rpx 24rpx;
	font-size: 24rpx;
	border-radius: 6rpx;
	line-height: 1.5;
}

.device-item {
	background: #f8f9fa;
	border-radius: 12rpx;
	padding: 24rpx;
	margin-bottom: 16rpx;
}

.device-header {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 16rpx;
}

.device-info {
	flex: 1;
}

.device-name {
	display: block;
	font-size: 30rpx;
	font-weight: 500;
	color: #333;
}

.device-code {
	display: block;
	font-size: 24rpx;
	color: #999;
	margin-top: 4rpx;
}

.device-status {
	font-size: 22rpx;
	padding: 4rpx 16rpx;
	border-radius: 4rpx;
}

.device-status.online {
	background: #F6FFED;
	color: #52C41A;
}

.device-status.offline {
	background: #FFF2F0;
	color: #FF4D4F;
}

.device-body {
	margin-bottom: 16rpx;
}

.info-row {
	display: flex;
	margin-bottom: 8rpx;
	font-size: 26rpx;
}

.info-row .label {
	color: #999;
	width: 120rpx;
}

.info-row .value {
	color: #333;
	flex: 1;
}

.device-footer {
	display: flex;
	justify-content: flex-end;
	gap: 16rpx;
	padding-top: 16rpx;
	border-top: 1rpx solid #e8e8e8;
}

/* 弹窗样式 */
.modal-mask {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: rgba(0, 0, 0, 0.5);
	z-index: 1000;
	display: flex;
	align-items: center;
	justify-content: center;
}

.modal-content {
	width: 90%;
	max-width: 600rpx;
	background: #fff;
	border-radius: 16rpx;
	overflow: hidden;
}

.modal-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 24rpx 30rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333;
}

.modal-close {
	font-size: 40rpx;
	color: #999;
	padding: 0 10rpx;
}

.modal-body {
	padding: 30rpx;
}

.form-item {
	margin-bottom: 24rpx;
}

.form-label {
	display: block;
	font-size: 26rpx;
	color: #666;
	margin-bottom: 12rpx;
}

.required {
	color: #FF4D4F;
}

.form-input {
	width: 100%;
	padding: 16rpx;
	border: 1rpx solid #d9d9d9;
	border-radius: 8rpx;
	font-size: 28rpx;
	box-sizing: border-box;
}

.picker-value {
	color: #333;
}

.picker-value.placeholder {
	color: #999;
}

.modal-footer {
	display: flex;
	padding: 20rpx 30rpx;
	border-top: 1rpx solid #f0f0f0;
	gap: 20rpx;
}

.modal-footer button {
	flex: 1;
}

.btn-cancel {
	background: #f5f5f5;
	color: #666;
	border-radius: 8rpx;
	padding: 16rpx;
	font-size: 28rpx;
}

.empty-state {
	text-align: center;
	padding: 60rpx 0;
	color: #999;
}

.empty-state button {
	width: 50%;
	margin: 0 auto;
}
