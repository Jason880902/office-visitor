<!--pages/my/index/index.wxml - 我的页面-->
<view class="container">
	<!-- 用户信息卡片 -->
	<view class="card user-card">
		<image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
		<view class="user-info">
			<text class="nick-name">{{userInfo.nickName || '未登录'}}</text>
			<text class="phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
			<view class="role-badge">{{roleText}}</view>
		</view>
	</view>

	<!-- 功能菜单 -->
	<view class="card menu-card">
		<view class="menu-item" bindtap="goMyList">
			<image src="/images/menu/visitor.png" mode="aspectFit" />
			<text class="menu-text">我的预约</text>
			<text class="menu-arrow">›</text>
		</view>

		<view class="menu-item" wx:if="{{isApprover || isAdmin}}" bindtap="goApprove">
			<image src="/images/menu/approve.png" mode="aspectFit" />
			<text class="menu-text">审批管理</text>
			<view class="menu-badge" wx:if="{{pendingCount > 0}}">{{pendingCount}}</view>
			<text class="menu-arrow">›</text>
		</view>

		<view class="menu-item" wx:if="{{isGatekeeper || isAdmin}}" bindtap="goScan">
			<image src="/images/menu/scan.png" mode="aspectFit" />
			<text class="menu-text">扫码核验</text>
			<text class="menu-arrow">›</text>
		</view>

		<view class="menu-item" wx:if="{{isAdmin}}" bindtap="goAdmin">
			<image src="/images/menu/admin.png" mode="aspectFit" />
			<text class="menu-text">后台管理</text>
			<text class="menu-arrow">›</text>
		</view>
	</view>

	<view class="card menu-card">
		<view class="menu-item" bindtap="goEdit">
			<image src="/images/menu/edit.png" mode="aspectFit" />
			<text class="menu-text">编辑资料</text>
			<text class="menu-arrow">›</text>
		</view>

		<view class="menu-item" bindtap="goAbout">
			<image src="/images/menu/about.png" mode="aspectFit" />
			<text class="menu-text">关于我们</text>
			<text class="menu-arrow">›</text>
		</view>
	</view>

	<!-- 退出登录 -->
	<view class="logout-btn" bindtap="onLogout" wx:if="{{userInfo}}">
		<text>退出登录</text>
	</view>
</view>
