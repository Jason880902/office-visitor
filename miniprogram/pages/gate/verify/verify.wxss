/* pages/gate/verify/verify.wxss */
.verify-card {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 80rpx 30rpx;
}

.loading-icon {
	margin-bottom: 30rpx;
}

.spinner {
	width: 60rpx;
	height: 60rpx;
	border: 4rpx solid #f0f0f0;
	border-top-color: #1890FF;
	border-radius: 50%;
	animation: spin 0.8s linear infinite;
}

@keyframes spin {
	to { transform: rotate(360deg); }
}

.loading-text {
	font-size: 28rpx;
	color: #666;
}

.result-card {
	margin-bottom: 20rpx;
}

.result-header {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 40rpx;
	border-radius: 12rpx 12rpx 0 0;
}

.result-header.success {
	background: linear-gradient(135deg, #F6FFED 0%, #D9F7BE 100%);
}

.result-header.fail {
	background: linear-gradient(135deg, #FFF2F0 0%, #FFCCC7 100%);
}

.result-header image {
	width: 100rpx;
	height: 100rpx;
	margin-bottom: 20rpx;
}

.result-header text {
	font-size: 36rpx;
	font-weight: bold;
}

.result-header.success text {
	color: #52C41A;
}

.result-header.fail text {
	color: #FF4D4F;
}

.result-body {
	padding: 24rpx 30rpx;
}

.info-row {
	display: flex;
	padding: 16rpx 0;
	border-bottom: 1rpx solid #f5f5f5;
	font-size: 28rpx;
}

.info-row:last-child {
	border-bottom: none;
}

.info-row .label {
	color: #999;
	width: 180rpx;
}

.info-row .value {
	color: #333;
	flex: 1;
}

.fail-message {
	text-align: center;
	color: #FF4D4F;
	font-size: 30rpx;
	padding: 30rpx;
}

.section-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 20rpx;
	padding-bottom: 16rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.detail-item {
	display: flex;
	padding: 16rpx 0;
	font-size: 28rpx;
}

.detail-label {
	color: #999;
	width: 180rpx;
}

.detail-value {
	color: #333;
	flex: 1;
}

.action-bar {
	padding: 30rpx 20rpx;
	padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}
