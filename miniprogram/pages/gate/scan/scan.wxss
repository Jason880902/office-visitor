/* pages/gate/scan/scan.wxss */
.scan-card {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 60rpx 30rpx;
}

.scan-icon {
	width: 200rpx;
	height: 200rpx;
	margin-bottom: 30rpx;
}

.scan-icon image {
	width: 100%;
	height: 100%;
}

.scan-tip {
	font-size: 28rpx;
	color: #666;
	margin-bottom: 40rpx;
}

.scan-btn {
	width: 80%;
}

.result-card {
	margin-top: 20rpx;
}

.result-header {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 30rpx;
	border-radius: 12rpx 12rpx 0 0;
}

.result-header.success {
	background: #F6FFED;
}

.result-header.fail {
	background: #FFF2F0;
}

.result-header image {
	width: 80rpx;
	height: 80rpx;
	margin-bottom: 16rpx;
}

.result-header text {
	font-size: 32rpx;
	font-weight: bold;
}

.result-header.success text {
	color: #52C41A;
}

.result-header.fail text {
	color: #FF4D4F;
}

.result-body {
	padding: 20rpx 30rpx;
}

.info-row {
	display: flex;
	padding: 12rpx 0;
	font-size: 28rpx;
}

.info-row .label {
	color: #999;
	width: 160rpx;
}

.info-row .value {
	color: #333;
	flex: 1;
}

.fail-message {
	text-align: center;
	color: #FF4D4F;
	font-size: 28rpx;
	padding: 20rpx;
}

.result-footer {
	padding: 20rpx 30rpx 30rpx;
}

.section-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 20rpx;
}

.record-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 16rpx 0;
	border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
	border-bottom: none;
}

.record-info {
	flex: 1;
}

.record-name {
	display: block;
	font-size: 28rpx;
	color: #333;
}

.record-time {
	display: block;
	font-size: 24rpx;
	color: #999;
	margin-top: 4rpx;
}

.record-result {
	font-size: 24rpx;
	padding: 4rpx 16rpx;
	border-radius: 4rpx;
}

.record-result.success {
	background: #F6FFED;
	color: #52C41A;
}

.record-result.fail {
	background: #FFF2F0;
	color: #FF4D4F;
}

/* 手动输入弹窗 */
.btn-secondary {
	background: #f5f5f5;
	color: #666;
	border-radius: 8rpx;
	padding: 20rpx 40rpx;
	font-size: 28rpx;
	width: 80%;
}

.modal-mask {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: rgba(0, 0, 0, 0.5);
	z-index: 1000;
	display: flex;
	align-items: center;
	justify-content: center;
}

.modal-content {
	width: 85%;
	background: #fff;
	border-radius: 16rpx;
	overflow: hidden;
}

.modal-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 24rpx 30rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333;
}

.modal-close {
	font-size: 40rpx;
	color: #999;
	padding: 0 10rpx;
}

.modal-body {
	padding: 30rpx;
}

.input-field {
	width: 100%;
	padding: 20rpx;
	border: 1rpx solid #d9d9d9;
	border-radius: 8rpx;
	font-size: 28rpx;
	box-sizing: border-box;
}

.modal-footer {
	display: flex;
	padding: 20rpx 30rpx;
	border-top: 1rpx solid #f0f0f0;
	gap: 20rpx;
}

.modal-footer button {
	flex: 1;
}

.btn-cancel {
	background: #f5f5f5;
	color: #666;
	border-radius: 8rpx;
	padding: 16rpx;
	font-size: 28rpx;
}
